<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAYVEN</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --storm-dark: #0a0510;
    --storm-mid: #170c26;
    --purple: #9b6bff;
    --purple-glow: #7a4fe0;
    --gold: #e8c468;
    --gold-glow: #ffdd88;
    --text: #e8ddff;
    --steel: #8a7ab0;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; overflow: hidden; }
  body {
    background: radial-gradient(ellipse at 50% 30%, var(--storm-mid) 0%, var(--storm-dark) 75%);
    font-family: 'Courier New', monospace;
    color: var(--text);
  }
  canvas { display: block; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; cursor: grab; z-index: 0; }
  canvas.dragging { cursor: grabbing; }

  .lightning-line {
    position: fixed; top: -5vh; width: 2px;
    background: linear-gradient(180deg, var(--gold-glow), var(--purple-glow), transparent);
    filter: drop-shadow(0 0 6px var(--gold-glow)) drop-shadow(0 0 16px var(--purple-glow));
    opacity: 0; z-index: 1; pointer-events: none;
  }
  .lightning-line.strike { animation: lightningFlicker 0.4s ease-out forwards; }
  @keyframes lightningFlicker { 0% { opacity: 0; } 8% { opacity: 1; } 15% { opacity: 0.1; } 22% { opacity: 0.9; } 35% { opacity: 0.15; } 100% { opacity: 0; } }

  .rain-bolt {
    position: fixed; top: -15vh; width: 3px; height: 40vh;
    background: linear-gradient(180deg, #fff6d8, var(--gold-glow), var(--gold));
    filter: drop-shadow(0 0 8px var(--gold-glow)) drop-shadow(0 0 18px var(--gold));
    opacity: 0; z-index: 6; pointer-events: none;
  }
  .rain-bolt.fall { animation: rainFall 0.7s ease-in forwards; }
  @keyframes rainFall {
    0% { opacity: 0; transform: translateY(0); }
    8% { opacity: 1; }
    20% { opacity: 0.2; }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(130vh); }
  }

  .impact-bolt {
    position: fixed; width: 3px; height: 22vh;
    background: linear-gradient(180deg, #d8c6ff, var(--purple), var(--purple-glow));
    filter: drop-shadow(0 0 2px var(--gold)) drop-shadow(0 0 4px var(--gold-glow)) drop-shadow(0 0 16px var(--purple));
    opacity: 0; z-index: 8; pointer-events: none;
    transform-origin: top center;
  }
  .impact-bolt.crackle { animation: crackleOut 0.55s ease-out forwards; }
  @keyframes crackleOut {
    0% { opacity: 0; transform: translate(-50%,-50%) rotate(var(--ang)) scaleY(0.2); }
    12% { opacity: 1; }
    30% { opacity: 0.3; }
    45% { opacity: 1; }
    100% { opacity: 0; transform: translate(-50%,-50%) rotate(var(--ang)) scaleY(1.4); }
  }

  #wakeOverlay { position: fixed; inset: 0; pointer-events: none; z-index: 7; }
  #mjolnir {
    position: fixed; top: 50%; left: 50%; width: 90px; height: 148px;
    transform: translate(-50%, -180vh) rotate(-20deg); opacity: 0;
    filter: drop-shadow(0 0 22px var(--gold)) drop-shadow(0 0 40px var(--purple));
  }
  #wakeOverlay.active #mjolnir { animation: hammerDrop 0.95s cubic-bezier(.5,1.8,.6,1) forwards; }
  @keyframes hammerDrop {
    0% { transform: translate(-50%, -180vh) rotate(-20deg); opacity: 0; }
    70% { transform: translate(-50%, -50%) rotate(8deg); opacity: 1; }
    78% { transform: translate(-50%, -46%) rotate(-4deg); }
    86% { transform: translate(-50%, -50%) rotate(0deg); opacity: 1; }
    100% { transform: translate(-50%, -50%) rotate(0deg); opacity: 0; }
  }
  #impactRing {
    position: fixed; top: 50%; left: 50%; width: 30px; height: 30px; border-radius: 50%;
    border: 3px solid var(--purple-glow); transform: translate(-50%,-50%) scale(0); opacity: 0;
    box-shadow: 0 0 20px var(--gold), 0 0 40px var(--purple);
  }
  #wakeOverlay.active #impactRing { animation: impactExpand 0.8s ease-out 0.68s forwards; }
  @keyframes impactExpand { 0% { transform: translate(-50%,-50%) scale(0); opacity: 1; } 100% { transform: translate(-50%,-50%) scale(16); opacity: 0; } }

  #wakeFlash { position: fixed; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(155,107,255,0.55), rgba(232,196,104,0.25) 45%, transparent 65%); opacity: 0; z-index: 6; pointer-events: none; }
  #wakeOverlay.active #wakeFlash { animation: wakeFlashAnim 1.3s ease-out forwards; }
  @keyframes wakeFlashAnim { 0% { opacity: 0; } 68% { opacity: 0; } 74% { opacity: 1; } 100% { opacity: 0; } }

  #wordmark {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
    text-align: center; pointer-events: none; z-index: 2;
    transition: opacity 0.3s ease;
  }
  #wordTitle {
    font-family: 'Orbitron', sans-serif; font-weight: 900;
    font-size: clamp(18px, 3.4vw, 30px); letter-spacing: 6px;
    color: var(--purple);
    text-shadow: 0 0 10px var(--purple-glow), 0 0 24px var(--purple-glow), 0 0 4px var(--gold-glow);
    display: flex; justify-content: center; gap: 8px;
    animation: wordFlicker 6s infinite;
  }
  #wordTitle .letter { display: inline-block; transition: transform 1.1s cubic-bezier(.22,1.6,.36,1); }
  #wordSubtitle {
    font-family: 'Courier New', monospace; font-size: clamp(8px, 1vw, 10px);
    letter-spacing: 3px; color: var(--gold); opacity: 0.85; margin-top: 6px;
    text-shadow: 0 0 6px var(--gold-glow);
  }
  #wordmark.sleeping #wordTitle { animation: none; color: var(--steel); opacity: 0.75; }
  #wordmark.sleeping #wordSubtitle { opacity: 0.4; }
  #wordmark.dimmed { opacity: 0; }
  @keyframes wordFlicker { 0%,94%,100% { opacity: 1; } 95% { opacity: 0.5; } 96% { opacity: 1; } 97% { opacity: 0.3; } 98% { opacity: 1; } }

  /* The "brain" — welcome message that pops up in the center when the hammer lands */
  #welcomeText {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.6);
    font-family: 'Orbitron', sans-serif; font-weight: 900;
    font-size: clamp(20px, 4.2vw, 38px); letter-spacing: 4px;
    color: var(--gold);
    text-shadow: 0 0 12px var(--gold-glow), 0 0 28px var(--gold), 0 0 50px var(--gold-glow);
    text-align: center; pointer-events: none; z-index: 5;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(.22,1.6,.36,1);
  }
  #welcomeText.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  .corner-box {
    position: fixed; z-index: 10;
    background: rgba(20,10,35,0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(232,196,104,0.25);
    border-radius: 8px;
    padding: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.35);
  }

  #chatBox { top: 16px; left: 16px; width: 300px; max-width: 88vw; }
  #chatLog { max-height: 180px; overflow-y: auto; font-size: 11px; line-height: 1.4; margin-bottom: 8px; padding-right: 4px; }
  #chatLog .msg { margin-bottom: 7px; }
  #chatLog .label { font-size: 9px; letter-spacing: 1px; opacity: 0.7; display: block; }
  #chatLog .user .label { color: var(--steel); }
  #chatLog .rayven .label { color: var(--gold); }
  .chat-input-row { display: flex; gap: 6px; }
  #chatBox input {
    flex: 1; min-width: 0; padding: 7px 9px; border-radius: 4px; border: 1px solid rgba(232,196,104,0.3);
    background: rgba(10,5,16,0.6); color: var(--text); font-family: inherit; font-size: 11px;
  }
  #chatBox input:focus { outline: none; border-color: var(--gold); }
  .mini-btn {
    padding: 7px 10px; border-radius: 4px; border: 1px solid var(--gold); background: transparent;
    color: var(--gold); font-size: 10px; letter-spacing: 1px; cursor: pointer; white-space: nowrap;
  }
  .mini-btn:hover { background: var(--gold); color: #0a0510; }

  #settingsBox { bottom: 16px; left: 16px; width: 250px; max-width: 88vw; font-size: 10px; }
  #settingsBox .status-line { letter-spacing: 2px; color: var(--steel); margin-bottom: 8px; }
  #settingsBox .status-line span { color: var(--gold); }
  #settingsBox .row { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; flex-wrap: wrap; }
  #settingsBox label { display: flex; align-items: center; gap: 5px; cursor: pointer; color: var(--steel); font-size: 9px; letter-spacing: 1px; }
  #settingsBox select {
    background: rgba(10,5,16,0.6); color: var(--text); border: 1px solid rgba(232,196,104,0.3);
    border-radius: 4px; padding: 4px 6px; font-family: inherit; font-size: 9px; max-width: 140px;
  }
  #activateBtn { width: 100%; margin-bottom: 8px; border-color: var(--purple); color: var(--purple); }
  #activateBtn:hover { background: var(--purple); color: #0a0510; }
  #activateBtn.hidden { display: none; }
</style>
</head>
<body>

<div id="wordmark">
  <div id="wordTitle"></div>
  <div id="wordSubtitle">RAYAN'S AI ASSISTANT</div>
</div>
<div id="welcomeText">WELCOME HOME,<br>SIR</div>
<canvas id="sphereCanvas"></canvas>

<div id="wakeOverlay">
  <div id="wakeFlash"></div>
  <div id="impactRing"></div>
  <svg id="mjolnir" viewBox="0 0 100 160" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="headGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ffd15c"/>
        <stop offset="100%" stop-color="#9b6bff"/>
      </linearGradient>
      <linearGradient id="handleGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3a2a5e"/>
        <stop offset="100%" stop-color="#1a1030"/>
      </linearGradient>
    </defs>
    <rect x="18" y="2" width="64" height="46" rx="7" fill="url(#headGrad)" stroke="#fff2c8" stroke-width="1.5"/>
    <rect x="18" y="18" width="64" height="5" fill="#fff2c8" opacity="0.7"/>
    <rect x="42" y="48" width="16" height="105" rx="5" fill="url(#handleGrad)" stroke="#9b6bff" stroke-width="1"/>
