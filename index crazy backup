</div>

<script>
const wordmarkEl = document.getElementById('wordmark');
const wordTitleEl = document.getElementById('wordTitle');
const welcomeTextEl = document.getElementById('welcomeText');

function setTitleText(text) {
  wordTitleEl.innerHTML = '';
  text.split('').forEach(ch => {
    const span = document.createElement('span');
    span.className = 'letter';
    span.textContent = ch;
    wordTitleEl.appendChild(span);
  });
}
setTitleText('RAYVEN');

function setSleepingVisual(isSleeping) {
  wordmarkEl.classList.toggle('sleeping', isSleeping);
}

function scatterLetters() {
  const letters = document.querySelectorAll('#wordTitle .letter');
  letters.forEach(letter => {
    letter.style.transition = 'none';
    const dx = (Math.random() - 0.5) * 500;
    const dy = (Math.random() - 0.5) * 400;
    const rot = (Math.random() - 0.5) * 720;
    letter.style.transform = `translate(${dx}px, ${dy}px) rotate(${rot}deg)`;
    letter.style.opacity = '0.15';
  });
  void wordTitleEl.offsetWidth;
  requestAnimationFrame(() => {
    letters.forEach((letter, i) => {
      letter.style.transition = `transform 1.1s cubic-bezier(.22,1.6,.36,1) ${i * 0.03}s, opacity 0.9s ease ${i * 0.03}s`;
      letter.style.transform = 'translate(0,0) rotate(0deg)';
      letter.style.opacity = '1';
    });
  });
}

const canvas = document.getElementById('sphereCanvas');
const ctx = canvas.getContext('2d');

function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
resize();
window.addEventListener('resize', resize);

const SEED_COUNT = 320;
const SUBDOTS_PER_SEED = 7;
function baseSphereRadius() { return Math.min(window.innerWidth, window.innerHeight) * 0.26; }

const points = [];
const goldenAngle = Math.PI * (3 - Math.sqrt(5));
for (let i = 0; i < SEED_COUNT; i++) {
  const y = 1 - (i / (SEED_COUNT - 1)) * 2;
  const radiusAtY = Math.sqrt(1 - y * y);
  const theta = goldenAngle * i;
  const sx = Math.cos(theta) * radiusAtY;
  const sz = Math.sin(theta) * radiusAtY;
  const sy = y;
  const isGoldAccent = Math.random() < 0.16;
  for (let k = 0; k < SUBDOTS_PER_SEED; k++) {
    const jitter = 0.035;
    points.push({
      ux: sx + (Math.random() - 0.5) * jitter,
      uy: sy + (Math.random() - 0.5) * jitter,
      uz: sz + (Math.random() - 0.5) * jitter,
      goldAccent: isGoldAccent
    });
  }
}

const STATES = {
  idle:      { scale: 1.00, speed: 0.004, colorMix: 0.00, lightningRate: 1.0 },
  listening: { scale: 1.18, speed: 0.010, colorMix: 0.15, lightningRate: 1.4 },
  thinking:  { scale: 0.82, speed: 0.022, colorMix: 0.75, lightningRate: 1.8 },
  talking:   { scale: 1.05, speed: 0.013, colorMix: 0.40, lightningRate: 2.4 },
  burst:     { scale: 1.30, speed: 0.045, colorMix: 0.60, lightningRate: 5.0 },
  sleeping:  { scale: 0.35, speed: 0.0015, colorMix: 0.00, lightningRate: 0.15 }
};

let current = { scale: 1, speed: 0.004, colorMix: 0, lightningRate: 1 };
let target = STATES.idle;
function setSphereState(name) { target = STATES[name] || STATES.idle; }
function lerp(a, b, t) { return a + (b - a) * t; }

// The "brain" (particle sphere) vanish effect: offset snaps deeply negative so the brain nearly disappears,
// then it eases itself back to normal size on its own — no separate animation loop needed.
let explosionOffset = 0;
function triggerVanish() {
  explosionOffset = -0.97;
}

let angleY = 0;
let angleX = 0.3;
let dragging = false;
let lastPointer = { x: 0, y: 0 };
let userZoom = 1;

function pointerDown(x, y) { dragging = true; lastPointer = { x, y }; canvas.classList.add('dragging'); }
function pointerMove(x, y) {
  if (!dragging) return;
  const dx = x - lastPointer.x, dy = y - lastPointer.y;
  angleY += dx * 0.005;
  angleX += dy * 0.005;
  angleX = Math.max(-1.3, Math.min(1.3, angleX));
  lastPointer = { x, y };
}
function pointerUp() { dragging = false; canvas.classList.remove('dragging'); }

canvas.addEventListener('mousedown', e => pointerDown(e.clientX, e.clientY));
window.addEventListener('mousemove', e => pointerMove(e.clientX, e.clientY));
window.addEventListener('mouseup', pointerUp);
canvas.addEventListener('touchstart', e => { const t = e.touches[0]; pointerDown(t.clientX, t.clientY); }, { passive: true });
canvas.addEventListener('touchmove', e => { const t = e.touches[0]; pointerMove(t.clientX, t.clientY); }, { passive: true });
canvas.addEventListener('touchend', pointerUp);
canvas.addEventListener('wheel', e => {
  e.preventDefault();
  userZoom += e.deltaY * -0.001;
  userZoom = Math.max(0.5, Math.min(2.2, userZoom));
}, { passive: false });

function rotateY(x, y, z, angle) { const c = Math.cos(angle), s = Math.sin(angle); return { x: x * c - z * s, y, z: x * s + z * c }; }
function rotateX(x, y, z, angle) { const c = Math.cos(angle), s = Math.sin(angle); return { x, y: y * c - z * s, z: y * s + z * c }; }
function mixColor(c1, c2, t) { return [Math.round(c1[0]+(c2[0]-c1[0])*t), Math.round(c1[1]+(c2[1]-c1[1])*t), Math.round(c1[2]+(c2[2]-c1[2])*t)]; }

const PURPLE_RGB = [155, 107, 255];
const GOLD_RGB = [232, 196, 104];

function render() {
  current.scale = lerp(current.scale, target.scale, 0.04);
  current.speed = lerp(current.speed, target.speed, 0.04);
  current.colorMix = lerp(current.colorMix, target.colorMix, 0.04);
  current.lightningRate = lerp(current.lightningRate, target.lightningRate, 0.04);
  explosionOffset = lerp(explosionOffset, 0, 0.045);

  ctx.fillStyle = 'rgba(10,5,16,0.32)';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  const centerX = canvas.width / 2;
  const centerY = canvas.height / 2;
  const radius = Math.max(0, baseSphereRadius() * current.scale * userZoom * (1 + explosionOffset));
  const perspective = baseSphereRadius() * current.scale * userZoom * 2.6;

  if (!dragging) angleY += current.speed;

  const baseMix = mixColor(PURPLE_RGB, GOLD_RGB, current.colorMix);

  const projected = points.map(p => {
    const px = p.ux * radius, py = p.uy * radius, pz = p.uz * radius;
    let r = rotateY(px, py, pz, angleY);
    r = rotateX(r.x, r.y, r.z, angleX);
    const scale = perspective / (perspective + r.z);
    return { x: centerX + r.x * scale, y: centerY + r.y * scale, z: r.z, scale, goldAccent: p.goldAccent };
  });

  projected.sort((a, b) => a.z - b.z);

  projected.forEach(p => {
    const size = Math.max(0.6, 1.9 * p.scale);
    const brightness = Math.min(1, Math.max(0.15, (p.scale - 0.7) * 2));
    const rgb = p.goldAccent ? GOLD_RGB : baseMix;
    ctx.save();
    ctx.shadowBlur = 9 * p.scale;
    ctx.shadowColor = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${brightness})`;
    ctx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${brightness})`;
    ctx.beginPath();
    ctx.arc(p.x, p.y, size, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  });

  requestAnimationFrame(render);
}
render();

function spawnLightning() {
  const line = document.createElement('div');
  line.className = 'lightning-line';
  const height = 20 + Math.random() * 55;
  line.style.height = height + 'vh';
  line.style.left = Math.random() * 100 + 'vw';
  line.style.top = (Math.random() * 40) + 'vh';
  line.style.transform = `rotate(${(Math.random() * 16 - 8)}deg)`;
  document.body.appendChild(line);
  requestAnimationFrame(() => line.classList.add('strike'));
  setTimeout(() => line.remove(), 500);
}
function ambientLightningLoop() {
  const count = 1 + Math.floor(Math.random() * 2);
  for (let i = 0; i < count; i++) setTimeout(spawnLightning, i * 80);
  const baseDelay = 5500 / Math.max(0.5, current.lightningRate);
  setTimeout(ambientLightningLoop, baseDelay + Math.random() * 3000);
}
setTimeout(ambientLightningLoop, 1500);

function spawnRainBolt(delay) {
  setTimeout(() => {
    const bolt = document.createElement('div');
    bolt.className = 'rain-bolt';
    bolt.style.left = Math.random() * 100 + 'vw';
    bolt.style.transform = `rotate(${(Math.random() * 14 - 7)}deg)`;
    document.body.appendChild(bolt);
    requestAnimationFrame(() => bolt.classList.add('fall'));
    setTimeout(() => bolt.remove(), 800);
  }, delay);
}
function rainLightning(count) {
  for (let i = 0; i < count; i++) spawnRainBolt(i * 55);
}

function spawnImpactBolt() {
  const bolt = document.createElement('div');
  bolt.className = 'impact-bolt';
  const angle = Math.random() * 360;
  bolt.style.setProperty('--ang', angle + 'deg');
  bolt.style.top = '50%';
  bolt.style.left = '50%';
  document.body.appendChild(bolt);
  requestAnimationFrame(() => bolt.classList.add('crackle'));
  setTimeout(() => bolt.remove(), 700);
}
function impactCrackle(count) {
  for (let i = 0; i < count; i++) setTimeout(spawnImpactBolt, i * 30);
}

// Lightning circling the whole screen for the duration the welcome text is showing
function lightningFlurry(durationMs) {
  const interval = 160;
  let elapsed = 0;
  const timer = setInterval(() => {
    spawnLightning();
    if (Math.random() > 0.5) spawnImpactBolt();
    elapsed += interval;
    if (elapsed >= durationMs) clearInterval(timer);
  }, interval);
}

let wakeSequenceRunning = false;

function wakeBurst() {
  if (wakeSequenceRunning) return;
  wakeSequenceRunning = true;

  const overlay = document.getElementById('wakeOverlay');
  overlay.classList.remove('active');
  void overlay.offsetWidth;
  overlay.classList.add('active');

  rainLightning(16);
  setSphereState('burst');

  setTimeout(() => {
    // hammer lands: the brain's particles vanish, "WELCOME HOME, SIR" appears in gold, lightning circles the screen
    triggerVanish();
    wordmarkEl.classList.add('dimmed');
    welcomeTextEl.classList.add('show');
    impactCrackle(10);
    lightningFlurry(1300);

    const greeting = "Welcome home, sir.";
    const log = document.getElementById('chatLog');
    log.innerHTML += `<div class="msg rayven"><span class="label">RAYVEN</span>${greeting}</div>`;
    log.scrollTop = log.scrollHeight;
    conversationHistory.push({ role: 'assistant', content: greeting });
    saveConversation();

    speak(greeting, () => {
      wakeSequenceRunning = false;
      startConvoListening();
    });
  }, 680);

  setTimeout(() => {
    welcomeTextEl.classList.remove('show');
    wordmarkEl.classList.remove('dimmed');
  }, 680 + 1300);

  setTimeout(() => {
    overlay.classList.remove('active');
    setSphereState('listening');
  }, 1600);
}

const BACKEND_URL = "https://rayven-backend.rayanfahil2.workers.dev";
const WAKE_PHRASES = [
  "hey rayven", "hey raven", "hey ray ven",
  "wake up raven", "wake up rayven", "wake raven",
  "okay raven", "ok raven", "okay rayven",
  "yo raven", "yo rayven",
  "a raven", "ay raven",
  "raven"
];
const SLEEP_PHRASES = ["go to sleep", "sleep now", "power down", "goodnight raven"];

function levenshtein(a, b) {
  const m = a.length, n = b.length;
  const dp = Array.from({ length: m + 1 }, () => new Array(n + 1).fill(0));
  for (let i = 0; i <= m; i++) dp[i][0] = i;
  for (let j = 0; j <= n; j++) dp[0][j] = j;
  for (let i = 1; i <= m; i++)
    for (let j = 1; j <= n; j++)
      dp[i][j] = a[i - 1] === b[j - 1] ? dp[i - 1][j - 1] : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
  return dp[m][n];
}
function containsRavenLike(transcript) {
  const words = transcript.toLowerCase().replace(/[^a-z\s]/g, '').split(/\s+/);
  return words.some(w => w.length >= 4 && levenshtein(w, 'raven') <= 1);
}
function matchesAny(transcript, list) {
  const clean = transcript.toLowerCase().trim();
  if (list.some(p => clean.includes(p))) return true;
  if (list === WAKE_PHRASES && containsRavenLike(clean)) return true;
  return false;
}

let conversationHistory = [];
try {
  const saved = localStorage.getItem('rayvenConversation');
  if (saved) conversationHistory = JSON.parse(saved);
} catch (e) { conversationHistory = []; }

function saveConversation() {
  try { localStorage.setItem('rayvenConversation', JSON.stringify(conversationHistory)); } catch (e) {}
}
function renderSavedConversation() {
  const log = document.getElementById('chatLog');
  conversationHistory.forEach(m => {
    const cls = m.role === 'user' ? 'user' : 'rayven';
    const label = m.role === 'user' ? 'YOU' : 'RAYVEN';
    log.innerHTML += `<div class="msg ${cls}"><span class="label">${label}</span>${m.content}</div>`;
  });
  log.scrollTop = log.scrollHeight;
}
renderSavedConversation();

function clearMemory() {
  conversationHistory = [];
  localStorage.removeItem('rayvenConversation');
  document.getElementById('chatLog').innerHTML = '';
}

let allVoices = [];
const voiceSelect = document.getElementById('voiceSelect');
function loadVoiceOptions() {
  allVoices = window.speechSynthesis.getVoices();
  if (!allVoices.length) return;
  voiceSelect.innerHTML = '';
  allVoices.forEach((v, i) => {
    const opt = document.createElement('option');
    opt.value = i;
    opt.textContent = `${v.name} (${v.lang})`;
    voiceSelect.appendChild(opt);
  });
  let preferredIndex = allVoices.findIndex(v => /natural|neural|enhanced/i.test(v.name) && /en/i.test(v.lang));
  if (preferredIndex === -1) preferredIndex = allVoices.findIndex(v => /male|david|daniel|guy|mark|fred|alex/i.test(v.name) && /en/i.test(v.lang));
  voiceSelect.value = preferredIndex !== -1 ? preferredIndex : 0;
  const saved = localStorage.getItem('rayvenVoiceIndex');
  if (saved !== null && allVoices[saved]) voiceSelect.value = saved;
}
if ('speechSynthesis' in window) {
  loadVoiceOptions();
  window.speechSynthesis.onvoiceschanged = loadVoiceOptions;
}
voiceSelect.addEventListener('change', () => localStorage.setItem('rayvenVoiceIndex', voiceSelect.value));

function testVoice() { speak("Systems online. Voice calibration complete, sir.", null); }

function speak(text, onDone) {
  if (!document.getElementById('voiceToggle').checked) { if (onDone) onDone(); return; }
  if (!('speechSynthesis' in window)) { if (onDone) onDone(); return; }

  window.speechSynthesis.cancel();

  const chosen = allVoices[voiceSelect.value];
  const sentences = (text.match(/[^.!?]+[.!?]*/g) || [text]).map(s => s.replace(/,/g, '').trim());
  let i = 0;

  function speakNext() {
    if (i >= sentences.length) { if (onDone) onDone(); return; }
    const utter = new SpeechSynthesisUtterance(sentences[i]);
    utter.rate = 1.15;
    utter.pitch = 1.0;
    if (chosen) utter.voice = chosen;
    utter.onend = () => { i++; setTimeout(speakNext, 50); };
    utter.onerror = () => { i++; setTimeout(speakNext, 50); };
    window.speechSynthesis.speak(utter);
  }

  setTimeout(speakNext, 90);
}

const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition;
let wakeRecognition = null;
let convoRecognition = null;
let voiceActive = false;
let awake = false;
let speakingNow = false;

function setVoiceStatus(msg) { document.getElementById('voiceStatus').textContent = msg; }

function activateVoice() {
  if (!SpeechRecognitionCtor) { alert('Voice recognition is not supported in this browser. Try Chrome.'); return; }
  voiceActive = true;
  document.getElementById('activateBtn').classList.add('hidden');
  startWakeListening();
}

function startWakeListening() {
  if (!voiceActive || awake) return;
  setSleepingVisual(false);
  setSphereState('idle');
  wakeRecognition = new SpeechRecognitionCtor();
  wakeRecognition.continuous = true;
  wakeRecognition.interimResults = true;
  wakeRecognition.lang = 'en-US';
  wakeRecognition.maxAlternatives = 5;

  wakeRecognition.onresult = (event) => {
    if (awake) return;
    for (let r = event.resultIndex; r < event.results.length; r++) {
      for (let alt = 0; alt < event.results[r].length; alt++) {
        if (matchesAny(event.results[r][alt].transcript, WAKE_PHRASES)) {
          awake = true;
          try { wakeRecognition.stop(); } catch (e) {}
          enterAwakeMode();
          return;
        }
      }
    }
  };
  wakeRecognition.onend = () => { if (voiceActive && !awake) { try { startWakeListening(); } catch (e) { setTimeout(startWakeListening, 200); } } };
  wakeRecognition.onerror = () => { if (voiceActive && !awake) setTimeout(() => { try { startWakeListening(); } catch (err) {} }, 200); };

  setVoiceStatus('Sleeping — say a wake word...');
  try { wakeRecognition.start(); } catch (e) {}
}

function enterAwakeMode() {
  speakingNow = true;
  wakeBurst();
  setVoiceStatus('Awake — listening...');
}

function exitAwakeMode() {
  awake = false;
  startWakeListening();
}

function startConvoListening() {
  speakingNow = false;
  if (!awake) return;
  setSphereState('listening');
  convoRecognition = new SpeechRecognitionCtor();
  convoRecognition.continuous = false;
  convoRecognition.interimResults = false;
  convoRecognition.lang = 'en-US';
  convoRecognition.maxAlternatives = 3;

  convoRecognition.onresult = (event) => {
    const transcript = event.results[0][0].transcript;
    if (matchesAny(transcript, SLEEP_PHRASES)) {
      speakingNow = true;
      speak("Powering down. I'll be here when you need me, sir.", () => { speakingNow = false; exitAwakeMode(); });
      return;
    }
    sendMessage(transcript, () => { if (awake) startConvoListening(); });
  };
  convoRecognition.onend = () => { if (awake && !speakingNow) setTimeout(() => { if (awake && !speakingNow) startConvoListening(); }, 200); };
  convoRecognition.onerror = () => { if (awake && !speakingNow) setTimeout(() => { if (awake && !speakingNow) startConvoListening(); }, 200); };

  try { convoRecognition.start(); } catch (e) {}
}

function handleTypedSend() {
  const input = document.getElementById('userInput');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  sendMessage(text, null);
}

async function sendMessage(text, onReplyDone) {
  const log = document.getElementById('chatLog');
  const status = document.getElementById('statusText');
  if (!text || !text.trim()) { if (onReplyDone) onReplyDone(); return; }
  text = text.trim();

  log.innerHTML += `<div class="msg user"><span class="label">YOU</span>${text}</div>`;
  status.textContent = "PROCESSING...";
  setSphereState('thinking');
  log.scrollTop = log.scrollHeight;

  conversationHistory.push({ role: 'user', content: text });

  const typingId = 'typing-' + Date.now();
  log.innerHTML += `<div class="msg rayven" id="${typingId}"><span class="label">RAYVEN</span>...</div>`;
  log.scrollTop = log.scrollHeight;

  try {
    const response = await fetch(BACKEND_URL, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ history: conversationHistory })
    });
    const data = await response.json();
    const replyText = data.reply || data.error;
    document.getElementById(typingId).innerHTML = `<span class="label">RAYVEN</span>${replyText}`;
    conversationHistory.push({ role: 'assistant', content: replyText });
    saveConversation();

    speakingNow = true;
    speak(replyText, () => {
      speakingNow = false;
      setSphereState(awake ? 'listening' : 'idle');
      if (onReplyDone) onReplyDone();
    });
  } catch (err) {
    document.getElementById(typingId).innerHTML = `<span class="label">RAYVEN</span>Connection error: ${err.message}`;
    setSphereState(awake ? 'listening' : 'idle');
    if (onReplyDone) onReplyDone();
  }
  status.textContent = "STANDING BY";
  log.scrollTop = log.scrollHeight;
}
</script>
